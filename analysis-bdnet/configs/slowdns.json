    "optional_flags": [
      "--udpgw-remote-server-addr",
      "--udpgw-max-connections",
      "--udpgw-transparent-dns"
    ],
    "note": "tun must addDisallowedApplication(the app) so the tunnel client's own DNS packets do not re-enter the tun"
  },
