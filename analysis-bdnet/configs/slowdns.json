  "local_proxy": {
    "purpose": "clean no-auth SOCKS5 for Telegram/apps/tun2socks; it logs in to the far end for the client",
    "listen": "127.0.0.1:1080 (0.0.0.0:1080 when LAN share is on)",
    "upstream": "127.0.0.1:7000 (the dnstt forwarder)",
    "relay_greeting_hex": "05020002",
    "telegram_test": "Telegram -> Settings -> Data and Storage -> Proxy -> SOCKS5 127.0.0.1 : 1080 (leave user/pass empty)",
    "lan_share_test": "curl -x socks5h://<phone-ip>:1080 http://example.com/"
  },
  "tun2socks": {
    "binary": {
      "name": "libtun2socks.so",
      "size": 160232,
      "upstream": "badvpn 1.999.127"
    },
    "argv": [
      "libtun2socks.so",
      "--tunfd",
      "<fd>",
      "--tunmtu",
      "1500",
      "--netif-ipaddr",
      "10.111.222.2",
      "--netif-netmask",
